{
  "description": "Prime directive 1: anything that posts, pushes or changes forge state asks the user first. Generated by scripts/build-adapters.mjs from hooks/outbound.json.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/confirm-outbound.sh\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "mcp__.*__((create|update|delete|merge|close|reopen|push|add|remove|assign|unassign|review|approve|revoke|link|unlink|manage|save|accept)_[a-z0-9_]*)",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/confirm-outbound.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
